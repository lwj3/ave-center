# ============================================
# AVE 学习中心 Docker 部署环境变量
# 复制此文件为 .env 并修改配置
# ============================================

# --- MySQL 数据库 ---
MYSQL_ROOT_PASSWORD=root123456
DB_NAME=ave_center
DB_USER=ave_center
DB_PASSWORD=ave_center_pass

# --- 后端 ---
JWT_SECRET=your-secret-key-change-this-in-production
CLIENT_URL=http://localhost

# --- 前端 ---
# 生产环境填后端地址，如 http://your-server-ip:3000
# 如果前端和后端在同一 Docker 网络内，留空即可（Nginx 会代理 /api 到后端）
VITE_API_BASE=
